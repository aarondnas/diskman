# The same basic formatting in every editor, on Windows and on Linux (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Backend: as rustfmt does it (src-tauri/rustfmt.toml)
[*.rs]
indent_size = 4
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

# NSIS reads UTF-8 only with a byte order mark (src-tauri/windows/installer-hooks.nsh)
[*.nsh]
charset = utf-8-bom
