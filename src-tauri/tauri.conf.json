{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diskman",
  "version": "0.1.1",
  "identifier": "app.diskman.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Diskman",
        "width": 1200,
        "height": 820,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "theme": "Dark",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Local backups: copy your folders to one or more archives",
    "longDescription": "Diskman backs up folders to archives (other folders, e.g. on an external drive), as an exact mirror or add-only, with a preview of every change, move detection and schedules.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3QTQyN0Q5NzEwMDA2MDIKUldRQ0JnQngyU2VrMTlQOFpjSzA1V0VTSnJ5SzNCc25rZk5waFBtMEF2ZkRySWx0WXZXb0UybTYK",
      "endpoints": ["https://github.com/aarondnas/diskman/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
